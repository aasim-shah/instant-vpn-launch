# Nginx config for the VPN landing page on the Ubuntu VPS.
#
# Static SPA served from dist/. Two paths are proxied to the Node SEO service
# (PM2, 127.0.0.1:3001) so crawlers get real per-article meta + a live sitemap:
#
#   /sitemap.xml      -> live sitemap (static + case studies + ALL blogs)
#   /blog/<slug>      -> dist/index.html with real <title>/OG/JSON-LD injected
#
# Everything else (incl. /blog listing) stays static with SPA fallback.

server {
    listen 80;
    server_name fyreway.com www.fyreway.com;
    # (Use certbot/your TLS block for 443 in production.)

    root /home/vpn-sales-landing-page/dist;
    index index.html;

    # --- Live sitemap from the Node service ---
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:3001/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Blog detail pages: server-rendered meta/OG/JSON-LD ---
    # Matches /blog/<slug> only — NOT the /blog listing (that stays on the SPA).
    location ~ ^/blog/[^/]+/?$ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # --- Long-cache hashed build assets ---
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --- Everything else: static files, with SPA fallback to index.html ---
    location / {
        try_files $uri $uri/ /index.html;
    }
}
